# Oracle HCM Cloud Configuration
# Copy this file to .env and fill in your values

# Oracle HCM Cloud Host (e.g., mycompany.fa.us2.oraclecloud.com)
ORACLE_HCM_HOST=your-oracle-host.fa.us2.oraclecloud.com

# Authentication - Basic Auth
ORACLE_USERNAME=your.username@company.com
ORACLE_PASSWORD=your_password

# Authentication - OAuth 2.0 (alternative to Basic Auth)
# ORACLE_CLIENT_ID=your_client_id
# ORACLE_CLIENT_SECRET=your_client_secret
# ORACLE_TOKEN_URL=https://your-host.fa.us2.oraclecloud.com/oauth/oauthservice/token

# REST API Settings
ORACLE_API_VERSION=latest
ORACLE_MAX_RESULTS=500
ORACLE_REQUEST_TIMEOUT=30

# MCP Server Settings
MCP_SERVER_NAME=oracle-recruiting
MCP_LOG_LEVEL=INFO
